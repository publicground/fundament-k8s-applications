extends: relaxed

rules:
  # Line length
  line-length:
    max: 160
    level: warning

  # Indentation
  indentation:
    spaces: 2
    indent-sequences: true
    check-multi-line-strings: false

  # Brackets
  brackets:
    max-spaces-inside: 1
    max-spaces-inside-empty: 0

  # Braces
  braces:
    max-spaces-inside: 1
    max-spaces-inside-empty: 0

  # Truthy values
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false

  # Empty lines
  empty-lines:
    max: 1
    max-start: 0
    max-end: 1

  # Floating values
  float-values:
    require-numeral-before-decimal: true

  # Octal values
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
